  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
